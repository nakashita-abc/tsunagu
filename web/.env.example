# AUTH_DRIVER: stub（既定・モック認証） | cognito（Amazon Cognito User Pools に接続）
AUTH_DRIVER=stub
# AWS_REGION=ap-northeast-1
# COGNITO_CLIENT_ID=
# DB_DRIVER: stub（既定・モックデータ） | postgres（RDS 等の PostgreSQL に接続）

DB_DRIVER=stub
# DATABASE_URL=postgres://user:password@host:5432/dbname

# 招待直後のチャレンジトークン（NEW_PASSWORD_REQUIRED）を暗号化する鍵。
# 本番では必須。未設定のまま NODE_ENV=production で起動すると起動時エラーになる。
# AUTH_CHALLENGE_SECRET=
